# Database
# Create the databases once:  npm run db:create  (mysql -u root -p < scripts/db.sql)
# e2e runs against review_cepat_test (see .env.test) so e2e never touches dev data.
DATABASE_URL=mysql://user:password@localhost:3306/review_cepat

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google Places API (server-side only — never exposed to the client)
GOOGLE_PLACES_API_KEY=

# SSH deployment (scripts/deploy.sh)
SERVER=your-host
USER=your-ssh-user
APP_DIR=/var/www/nfc-platform
BRANCH=main